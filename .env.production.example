# Переменные для VPS (docker-compose.prod.yml). Скопируйте в .env.production и заполните.
# Файл .env.production в git не попадает.

# Домен сайта — Caddy сам получит HTTPS-сертификат (DNS домена должен указывать на сервер)
DOMAIN=novalab.kz

# База данных (внутри Docker, наружу не открыта)
POSTGRES_USER=novalab
POSTGRES_DB=novalab
POSTGRES_PASSWORD=замените-на-длинный-случайный-пароль

# Секрет сессий: openssl rand -base64 32
AUTH_SECRET=замените-на-случайную-строку-32+

# 1 — при каждом запуске обновлять программу (разделы и встроенные темы из content/); 0 — только миграции
SEED=1

# Почта для кодов восстановления пароля учителей и учеников (SMTP почтового сервиса домена).
# 465 — SSL, 587 — STARTTLS. Пример для почты на своём домене: smtp.mail.ru / smtp.yandex.ru / сервис хостинга.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=no-reply@novalab.kz
SMTP_PASS=
MAIL_FROM=NovaLab <no-reply@novalab.kz>

# Администратор панели /admin (создаётся или получает этот пароль при запуске миграций)
ADMIN_EMAIL=
ADMIN_PASSWORD=
