generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TEACHER
  ADMIN
  STUDENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(TEACHER)
  lessons      Lesson[]
  classrooms   Classroom[]
  memberships  Student[] // для роли STUDENT: участие в классах
  reviews      TeacherReview[]
  resets       PasswordReset[]
  createdAt    DateTime @default(now())
}

// Код восстановления пароля, отправленный на почту. В базе только хэш; код живёт 15 минут и даёт 5 попыток.
model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Администратор платформы. Отдельно от пользователей сайта: регистрации через сайт нет,
// создаётся только командой npm run admin:create или переменными ADMIN_EMAIL/ADMIN_PASSWORD при запуске.
model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
}

model Grade {
  id       Int       @id @default(autoincrement())
  number   Int       @unique
  textbook String? // учебник, по которому построена программа класса
  sections Section[]
}

model Section {
  id      Int     @id @default(autoincrement())
  title   String
  order   Int     @default(0)
  gradeId Int
  grade   Grade   @relation(fields: [gradeId], references: [id])
  topics  Topic[]
  terms   ClassTerm[]
  source  String  @default("seed") // seed — из программы content/curriculum.ts; package — создан пакетом темы

  @@unique([gradeId, title])
}

model Topic {
  id        Int      @id @default(autoincrement())
  title     String
  paragraph String? // параграфы учебника, например "§ 50–51"
  order     Int      @default(0)
  sectionId Int
  section   Section  @relation(fields: [sectionId], references: [id])
  modules   Module[]
  labNotes  LabNote[]
  packages  TopicPackage[]
  source    String   @default("seed") // seed — из программы content/curriculum.ts; package — создана пакетом темы

  @@unique([sectionId, title])
}

model Module {
  id           String        @id // slug, например "archimedes-sim"
  type         String        // simulation | summary | graph | quiz | matching | practice
  title        String
  description  String?
  order        Int           @default(0)
  version      String        @default("1.0.0")
  buildUrl     String?       // только для симуляций: ссылка на index.html WebGL-билда
  configSchema Json          @default("{}") // для симуляций и практики: настройки по умолчанию
  content      Json          @default("{}") // контент нативных модулей (см. lib/modules/types.ts)
  topicId      Int
  topic        Topic         @relation(fields: [topicId], references: [id])
  blocks       LessonBlock[]
  results      Result[]
  source       String        @default("seed") // seed — из content/ в репозитории; package — загружен пакетом темы из панели администратора
}

// Пакет темы, загруженный администратором: тема учебника со всеми модулями (и Unity-билдами)
model TopicPackage {
  id         String   @id @default(cuid())
  topicId    Int?
  topic      Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  title      String // «7 кл. · § 12 · Плотность вещества…»
  version    String
  fileName   String
  size       Int
  modules    Json     @default("[]") // [{ id, type, title }]
  uploadedBy String?
  createdAt  DateTime @default(now())
  removedAt  DateTime? // пакет темы удалён администратором
  removedBy  String?
}

// Встроенный модуль, удалённый администратором вместе с пакетом темы: сид больше не создаёт его заново.
// Загрузка пакета с тем же id модуля снимает отметку.
model RemovedModule {
  id        String   @id
  removedAt DateTime @default(now())
}

model Lesson {
  id          String        @id @default(cuid())
  title       String
  isPublished Boolean       @default(false)
  ownerId     String
  owner       User          @relation(fields: [ownerId], references: [id])
  blocks      LessonBlock[]
  classrooms  Classroom[] // классы, которым урок назначен
  results     Result[]
  feedback    LessonFeedback[]
  reviews     TeacherReview[]
  deadlines   LessonDeadline[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model LessonBlock {
  id       String @id @default(cuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id])
  position Int
  config   Json   @default("{}")
}

// Класс учителя: ученики входят по коду класса
model Classroom {
  id        String    @id @default(cuid())
  name      String
  code      String    @unique
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id])
  students  Student[]
  lessons   Lesson[]
  feedback  LessonFeedback[]
  reviews   TeacherReview[]
  terms     ClassTerm[]
  deadlines LessonDeadline[]
  createdAt DateTime  @default(now())
}

model Student {
  id          String    @id @default(cuid())
  name        String
  pin         String // 4 цифры: защищает от входа под чужим именем, учитель видит PIN в списке
  token       String    @unique // секрет в cookie ученика (быстрый вход без аккаунта)
  userId      String? // аккаунт ученика, если он зарегистрирован
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  results     Result[]
  feedback    LessonFeedback[]
  createdAt   DateTime  @default(now())

  @@unique([classroomId, name])
  @@unique([classroomId, userId])
}

// Одна попытка ученика в оцениваемом модуле
model Result {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id])
  kind      String // quiz | matching | practice | challenge
  score     Float // 0..1
  correct   Boolean?
  detail    Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([lessonId, studentId])
}

// Отзыв ученика в конце урока. Ссылки обнуляются при удалении ученика, класса или урока,
// а названия сохранены копией — отзыв остаётся в панели администратора.
model LessonFeedback {
  id            String     @id @default(cuid())
  rating        Int // 1..10
  liked         String?
  disliked      String?
  studentId     String?
  student       Student?   @relation(fields: [studentId], references: [id], onDelete: SetNull)
  lessonId      String?
  lesson        Lesson?    @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  classroomId   String?
  classroom     Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  teacherId     String? // владелец класса на момент отзыва
  lessonTitle   String
  classroomName String
  studentName   String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([studentId, lessonId])
  @@index([classroomId])
}

// Анкета учителя после урока в классе
model TeacherReview {
  id            String     @id @default(cuid())
  rating        Int // 1..10
  answers       Json       @default("{}") // ответы на вопросы lib/feedback.ts: { questionId: value | value[] }
  comment       String?
  teacherId     String?
  teacher       User?      @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  lessonId      String?
  lesson        Lesson?    @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  classroomId   String?
  classroom     Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  lessonTitle   String
  classroomName String
  teacherName   String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([lessonId, classroomId])
}

// План класса: какой раздел учебника проходят в какую четверть и в какие даты
// (обычно полчетверти — один раздел, полчетверти — другой). По нему журнал открывается на текущем разделе.
model ClassTerm {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  quarter     Int // 1..4
  sectionId   Int
  section     Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  startDate   DateTime
  endDate     DateTime

  @@unique([classroomId, quarter, sectionId])
  @@index([classroomId])
}

// Срок сдачи урока в классе: после него результаты ученика по уроку не принимаются
model LessonDeadline {
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  dueAt       DateTime

  @@id([classroomId, lessonId])
}

// «Моя лаборатория»: одна заметка ученика по теме учебника. owner — "u:<id аккаунта>" или "s:<id ученика без аккаунта>"
model LabNote {
  id        String   @id @default(cuid())
  owner     String
  topicId   Int
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  text      String
  updatedAt DateTime @updatedAt

  @@unique([owner, topicId])
}
